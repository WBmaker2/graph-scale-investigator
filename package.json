{
  "name": "graph-scale-investigator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "그래프 눈금 수사대 - 초등 5~6학년 수학 그래프 표현 비판적 점검 교육용 웹앱",
  "scripts": {
